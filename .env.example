# Auth key de Tailscale (https://login.tailscale.com/admin/settings/keys), con la etiqueta tag:mimusica
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Nombre de tu tailnet: la parte "tail1234" de https://mimusica.tail1234.ts.net
# Lo ves en https://login.tailscale.com/admin/dns ("Tailnet name").
TS_TAILNET=tail1234

# Carpeta de música del NAS
MUSIC_DIR=/volume1/Media/Music

# Opcional: Skill ID (amzn1.ask.skill.…). También se puede poner desde la consola.
ALEXA_SKILL_ID=

TZ=Europe/Madrid

# Puerto de la consola web en tu red local
CONSOLE_PORT=8080

# Cada cuántos segundos busca Watchtower una versión nueva (3600 = cada hora)
UPDATE_INTERVAL=3600
